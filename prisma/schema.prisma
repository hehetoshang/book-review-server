generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  nickname     String
  avatar       String?
  password     String   @default("")
  role         String   @default("user")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  accessTime   DateTime?
  comments     Comment[]
  thirdParties ThirdPartyUser[]

  @@map("users")
}

model App {
  id          Int      @id @default(autoincrement())
  appId       String   @unique
  secret      String
  name        String
  domains     String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comments    Comment[]
  nonces      Nonce[]

  @@map("apps")
}

model ThirdPartyUser {
  id             Int      @id @default(autoincrement())
  appId          Int
  app            App      @relation(fields: [appId], references: [id])
  externalId     String
  externalEmail  String?
  externalNick   String?
  internalUserId Int
  internalUser   User     @relation(fields: [internalUserId], references: [id])
  lastLoginAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([appId, externalId])
  @@map("third_party_users")
}

model Nonce {
  id        Int      @id @default(autoincrement())
  appId     Int
  app       App      @relation(fields: [appId], references: [id])
  nonce     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([nonce], map: "idx_nonce")
  @@map("nonces")
}

model Comment {
  id          Int      @id @default(autoincrement())
  appId       Int
  app         App      @relation(fields: [appId], references: [id])
  bookId      Int      @default(0)
  bookTitle   String   @default("")
  chapterId   Int      @default(0)
  chapterName String   @default("")
  segmentId   Int      @default(0)
  cfi         String   @default("")
  cfiBase     String   @default("")
  content     String   @default("")
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  rootId      Int?
  quoteId     Int?
  level       Int      @default(0)
  type        Int      @default(1)
  geo         String   @default("")
  likeCount   Int      @default(0)
  dislikeCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([appId, chapterId], map: "idx_app_chapter")
  @@index([userId], map: "idx_user")
  @@index([appId], map: "idx_app")
  @@map("comments")
}
