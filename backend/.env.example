# JWT 配置
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# 代理登录配置
PROXY_TOKEN_TTL=300
RATE_LIMIT_PER_MINUTE=5

# 运行环境
NODE_ENV=development

# 数据库配置
# 支持的数据库类型: sqlite, mysql, postgresql
DATABASE_TYPE=sqlite

# SQLite（自动在 data/ 目录下创建）
DATABASE_URL=sqlite+aiosqlite:///./data/chapter_comments.db

# MySQL（取消注释使用）
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/chapter_comments

# PostgreSQL（取消注释使用）
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chapter_comments

# CORS
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true

# 服务器
HOST=0.0.0.0
PORT=8000
