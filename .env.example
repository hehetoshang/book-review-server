# Database (MySQL - 生产环境，包含原有数据)
DATABASE_URL="mysql://user:password@localhost:3306/brs"

# JWT Configuration
JWT_SECRET="your-super-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Proxy Login Token TTL (seconds)
PROXY_TOKEN_TTL=300

# Rate Limit (comments per user per minute)
RATE_LIMIT_PER_MINUTE=5

# Node Environment
NODE_ENV="production"
